 // This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 数据库连接 URL 已迁移到 prisma.config.ts；运行时通过 driver adapter 连接。

/**
 * 知识库：一个知识库包含多篇文档，文档切分后用于 RAG 检索问答。
 */
model KnowledgeBase {
  id          String     @id @default(cuid())
  /** 知识库名称 */
  name        String
  /** 知识库描述 */
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  documents   Document[]

  @@map("knowledge_bases")
}

/**
 * 文档：存储上传文件的元数据与处理状态。
 * 实际文件内容被切分为 DocumentChunk 后持久化，便于向量化与检索。
 */
model Document {
  id              String         @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase  @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  /** 原始文件名 */
  fileName    String
  /** 文件 MIME 类型或扩展名，例如 pdf / txt / md */
  fileType    String
  /** 文件大小（字节） */
  fileSize    Int
  /** 文件存储路径；若使用对象存储可存 URL */
  filePath    String?
  /** 文档处理状态 */
  status      DocumentStatus @default(PENDING)
  /** 切分后的 chunk 总数 */
  totalChunks Int            @default(0)
  /** 附加元数据：如页数、标题、来源 URL 等 */
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chunks    DocumentChunk[]

  @@index([knowledgeBaseId])
  @@index([status])
  @@map("documents")
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/**
 * 文档切分块：RAG 检索的最小单元。
 * content 用于展示与重排序，embedding 用于向量相似度检索。
 *
 * 注意：embedding 使用 PostgreSQL pgvector 扩展的 vector 类型，
 * 维度 1536 对应 OpenAI text-embedding-3-small；若使用其他模型请调整维度。
 */
model DocumentChunk {
  id              String   @id @default(cuid())
  documentId      String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /** 冗余存储 knowledgeBaseId，方便按知识库检索时减少 JOIN */
  knowledgeBaseId String

  /** 该 chunk 在文档中的顺序 */
  chunkIndex Int
  /** 切分后的文本内容 */
  content    String  @db.Text
  /** 向量嵌入；pgvector 扩展，1024 维，对应百炼 text-embedding-v3 */
  embedding  Unsupported("vector(1024)")?
  /** chunk 级元数据：如页码、段落位置等 */
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([knowledgeBaseId])
  @@index([documentId])
  @@index([chunkIndex])
  @@map("document_chunks")
}
